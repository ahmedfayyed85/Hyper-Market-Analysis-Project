	measure 'Sales MoM Display' =
			
			VAR Change = [Sales MoM %]
			VAR Arrow =
			    SWITCH(
			        TRUE(),
			        Change > 0, "▲ ",
			        Change < 0, "▼ ",
			        "▬ "
			    )
			RETURN
			    Arrow & FORMAT(ABS(Change), "0.00%")
		lineageTag: 836c41a0-88da-4a55-a3ed-64cc98533568

