table _Measure
	lineageTag: 63bd1fc6-2442-478b-8a6b-70bf4c2289c4

	measure 'Total sales' = ```
			
			SUMX( 
			    SALES, 
			    SALES[quantity] * RELATED(Products[product_retail_price])
			    )
			    
			```
		lineageTag: e0030ce3-8424-41fe-9ce6-fd626c3022de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total cost' =
			
			SUMX(
			    SALES,
			    SALES[quantity] * RELATED(Products[product_cost] )
			    )
		lineageTag: 19c61413-d844-44ba-a5ab-4cd250165974

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total gross Profit' = [Total sales] - [Total cost]
		lineageTag: b4c2139b-d235-44cf-9e20-5f673e1a4d8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin %' =
			
			DIVIDE(
			    [Total Gross Profit],
			    [Total Sales],
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: dfce9096-e95b-4022-a284-3e411a6ab9d8

	measure 'Total Quantity' =
			
			SUM(Sales[quantity])
		formatString: 0
		lineageTag: 9dc51e36-50e5-4aa5-91c1-3470a6319da9

	measure 'Total Customers' =
			
			DISTINCTCOUNT(Sales[customer_id])
		formatString: 0
		lineageTag: bdf5ffa9-1b50-4fa3-909c-b56ae306c281

	measure 'Total Returns' =
			
			SUM(Returns[quantity])
		formatString: 0
		lineageTag: 2cab622f-7812-4069-af21-b76567c3031d

	measure 'Return Rate %' =
			
			DIVIDE(
			    [Total Returns],
			    [Total Quantity],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e61870f3-01b6-4e98-b56f-132be4396247

	measure 'Previous Month Sales' =
			
			CALCULATE(
			    [Total sales],
			    DATEADD(
			        Calendar[date],
			        -1,
			        MONTH
			    )
			)
		lineageTag: 1c6d7032-d592-40a2-9381-2595fd02a1d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales MoM %' =
			
			VAR CurrentSales = [Total sales]
			VAR PreviousSales = [Previous Month Sales]
			RETURN
			IF(
			    ISBLANK(PreviousSales),
			    BLANK(),
			    DIVIDE(
			        CurrentSales - PreviousSales,
			        PreviousSales
			    )
			)
		lineageTag: ab9ea790-734a-4ed9-a8ef-b247216f5208

		annotation PBI_FormatHint = {"isGeneralNumber":true}

